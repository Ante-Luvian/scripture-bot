# Python
__pycache__/
*.pyc

# Downloads cached by scripts/build_world_texts.py
scripts/.cache/

# the sung-chant experiments' scratch output (samples worth keeping go in samples/)
experiments/sung_chant/sung/

# the chanted psalms' audio: rebuilt by scripts/build_psalm_chant.py, not kept in git
data/psalter/chant/

# the chant hymns' audio (about 645 MB): rebuilt on the bot's machine, not kept in git -- the organ
# (more/) by scripts/build_chant.py, the sung choir (sung/) by scripts/build_sung_chant.py. The tests
# skip their audio checks where it hasn't been rendered. (The Sacred Harp's audio/harp/ and the hymn
# tunes were downloaded, not rendered, so they stay in git as their backup.)
data/hymns/audio/sung/
data/hymns/audio/more/

# chant scores: drawn by scripts/build_chant_scores.py, not kept in git
data/hymns/scores/
scripts/score/node_modules/

# Doré's Dante plates cut out of their page scans (~40 MB; rebuilt by scripts/build_dore.py)
data/dore/dante/

# texts the owner supplied for scripts/build_reformation.py (the built data/reformation files are committed)
scripts/sources/

# the PDF guides (scripts/build_guides.py)
guides/

# NASA JPL's planetary ephemeris for !planets (17 MB; downloaded from ssd.jpl.nasa.gov, see bot_commands/planets.py)
data/de421.bsp
